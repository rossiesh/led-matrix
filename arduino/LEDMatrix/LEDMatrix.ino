void moveBall() {
  deflectionAndScoringLEDs();
  led[ballPos].setRGB(0, 0, 0);
  if (directionBall == 1) {
    if (checkIfMoveIsValid(ballPos, ballPos - 20 + 1)) {
      ballPos = ballPos - 20 + 1;
    } else {
      directionBall = 2;
    }
  }
  if (directionBall == 3) {
    if (checkIfMoveIsValid(ballPos, ballPos - 10 + 2)) {
      ballPos = ballPos - 10 + 2;
    } else {
      directionBall = 2;
    }
  }
  if (directionBall == 2) {
    if (checkIfMoveIsValid(ballPos, ballPos - 10 + 1)) {
      ballPos = ballPos - 10 + 1;
    } else {
      directionBall = 14;
    }
  }
  if (directionBall == 4) {
    ballPos = ballPos + 1;
  }
  if (directionBall == 5) {
    if (checkIfMoveIsValid(ballPos, ballPos + 20 + 1)) {
      ballPos = ballPos + 20 + 1;
    } else {
      directionBall = 6;
    }
  }
  if (directionBall == 7) {
    if (checkIfMoveIsValid(ballPos, ballPos + 10 + 2)) {
      ballPos = ballPos + 10 + 2;
    } else {
      directionBall = 6;
    }
  }
  if (directionBall == 6) {
    if (checkIfMoveIsValid(ballPos, ballPos + 10 + 1)) {
      ballPos = ballPos + 10 + 1;
    } else {
      directionBall = 10;
    }
  }
  if (directionBall == 8) {
    ballPos = ballPos + 10;
  }
  if (directionBall == 9) {
    if (checkIfMoveIsValid(ballPos, ballPos + 20 - 1)) {
      ballPos = ballPos + 20 - 1;
    } else {
      directionBall = 10;
    }
  }
  if (directionBall == 11) {
    if (checkIfMoveIsValid(ballPos, ballPos + 10 - 2)) {
      ballPos = ballPos + 10 - 2;
    } else {
      directionBall = 10;
    }
  }
  if (directionBall == 10) {
    if (checkIfMoveIsValid(ballPos, ballPos + 10 - 1)) {
      ballPos = ballPos + 10 - 1;
    } else {
      directionBall = 6;
    }
  }
  if (directionBall == 12) {
    ballPos = ballPos - 1;
  }
  if (directionBall == 13) {
    if (checkIfMoveIsValid(ballPos, ballPos - 20 - 1)) {
      ballPos = ballPos - 20 - 1;
    } else {
      directionBall = 14;
    }
  }
  if (directionBall == 15) {
    if (checkIfMoveIsValid(ballPos, ballPos - 10 - 2)) {
      ballPos = ballPos - 10 - 2;
    } else {
      directionBall = 14;
    }
  }
  if (directionBall == 14) {
    if (checkIfMoveIsValid(ballPos, ballPos - 10 - 1)) {
      ballPos = ballPos - 10 - 1;
    } else {
      directionBall = 2;
    }
  }
  if (directionBall == 16) {
    ballPos = ballPos - 10;
  }
  led[ballPos].setRGB(0, 255, 0);
  FastLED.show();
}

bool checkIfMoveIsValid(int currentPos, int nextPos) {
  if (directionBall == 1 || directionBall == 5 || directionBall == 9 || directionBall == 13) {
    if (nextPos < 0 || nextPos > 99 || ballOnDeflectionLEDLeft(nextPos + 1) || ballOnDeflectionLEDRight(nextPos - 1)) {
      return false;
    }
  }
  if (directionBall == 3 || directionBall == 7 || directionBall == 11 || directionBall == 15) {
    if (abs((nextPos % 10) - (currentPos % 10)) != 2 || ballOnDeflectionLEDLeft(nextPos + 1) || ballOnDeflectionLEDRight(nextPos - 1)) {
      return false;
    }
  }
  if (directionBall == 2 || directionBall == 6 || directionBall == 10 || directionBall == 14) {
    if (ballOnDeflectionLEDLeft(nextPos + 1) || ballOnDeflectionLEDRight(nextPos - 1)) {
      return false;
    }
  }
  return true;
}

void deflectionAndScoringLEDs() {
  deflectionLEDsLeft[0] = playerLeftPos - 10 + 1;
  deflectionLEDsLeft[1] = playerLeftPos + 1;
  deflectionLEDsLeft[2] = playerLeftPos + 10 + 1;
  deflectionLEDsRight[0] = playerRightPos - 10 - 1;
  deflectionLEDsRight[1] = playerRightPos - 1;
  deflectionLEDsRight[2] = playerRightPos + 10 - 1;
  index = 0;
  for (int i = 0; i < 10; i++) {
    bool isDeflectionLED = false;
    for (int j = 0; j < 3; j++) {
      if (allLEDsLeft[i] == deflectionLEDsLeft[j] - 1) {
        isDeflectionLED = true;
        break;
      }
    }
    if (!isDeflectionLED) {
      scoringLEDsLeft[index++] = allLEDsLeft[i];
    }
  }
  index = 0;
  for (int i = 0; i < 10; i++) {
    bool isDeflectionLED = false;
    for (int j = 0; j < 3; j++) {
      if (allLEDsRight[i] == deflectionLEDsRight[j] + 1) {
        isDeflectionLED = true;
        break;
      }
    }
    if (!isDeflectionLED) {
      scoringLEDsRight[index++] = allLEDsRight[i];
    }
  }
}