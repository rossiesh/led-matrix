void prepareGameField() {
  interval = 300;
  playerLeftPos = 40;
  playerRightPos = 49;
  randNum = random(2);
  for (int i = 0; i < 100; i++) {
    led[i].setRGB(0, 0, 0);
  }
  led[playerLeftPos - 10].setRGB(255, 0, 0);
  led[playerLeftPos].setRGB(255, 0, 0);
  led[playerLeftPos + 10].setRGB(255, 0, 0);
  led[playerRightPos - 10].setRGB(255, 0, 0);
  led[playerRightPos].setRGB(255, 0, 0);
  led[playerRightPos + 10].setRGB(255, 0, 0);
  if (randNum == 0) {
    led[44].setRGB(0, 255, 0);
    ballPos = 44;
  } else {
    led[45].setRGB(0, 255, 0);
    ballPos = 45;
  }
  FastLED.setBrightness(100);
  display.setBrightness(7);
  FastLED.show();
  deflectionAndScoringLEDs();
  gamePause = true;
  directionBall = random(16);
}

void movePlayerLeft() {
  for (int i = 0; i < 91; i += 10) {
    led[i].setRGB(0, 0, 0);
  }
  led[playerLeftPos - 10].setRGB(255, 0, 0);
  led[playerLeftPos].setRGB(255, 0, 0);
  led[playerLeftPos + 10].setRGB(255, 0, 0);
  FastLED.show();
  deflectionAndScoringLEDs();
}

void movePlayerRight() {
  for (int i = 9; i < 100; i += 10) {
    led[i].setRGB(0, 0, 0);
  }
  led[playerRightPos - 10].setRGB(255, 0, 0);
  led[playerRightPos].setRGB(255, 0, 0);
  led[playerRightPos + 10].setRGB(255, 0, 0);
  FastLED.show();
  deflectionAndScoringLEDs();
}

bool ballOnDeflectionLEDLeft(int pos) {
  for (int i = 0; i < 3; i++) {
    if (pos == deflectionLEDsLeft[i]) {
      return true;
    }
  }
  return false;
}

