void setup() {
  randomSeed(analogRead(A0));
  FastLED.addLeds<WS2812B, DATA_PIN, GRB>(led, NUM_LEDS);
  FastLED.clear();
  FastLED.show();
  pinMode(button1, INPUT);
  pinMode(button2, INPUT);
  pinMode(button3, INPUT);
  pinMode(button4, INPUT);
  pinMode(button5, INPUT);
  pinMode(button6, INPUT);
  pinMode(button7, INPUT);
  display.setBrightness(displayBrightness);
  display.clear();
  Serial.begin(9600);
}
void loop() {



  currentTime = millis();

  if (digitalRead(button4) && mode == 1 && (currentTime - lastButton4Time >= debounceDelay)) {
    display.clear();
    subMode++;
    if (subMode > 3) {
      subMode = 1;
    }
    lastButton4Time = currentTime;
  }
  if (digitalRead(button4) && mode == 2 && (currentTime - lastButton4Time >= debounceDelay)) {
    display.clear();
    scorePlayerLeft = 0;
    scorePlayerRight = 0;
    prepareGameField();
    lastButton4Time = currentTime;
  }

  if (digitalRead(button3) && (currentTime - lastButton3Time >= debounceDelay)) {
    display.clear();
    mode++;
    if (mode == 2) {
      prepareGameField();
    }
    if (mode > 2) {
      mode = 1;
    }
    lastButton3Time = currentTime;
  }

  if (mode == 1) {
    if (subMode == 1) {
      if (digitalRead(button1) && (currentTime - lastButton1Time >= debounceDelay)) {
        animation++;
        if (animation > 11) {
          animation = 1;
        }
        lastButton1Time = currentTime;
      }
      if (digitalRead(button2) && (currentTime - lastButton2Time >= debounceDelay)) {
        animation--;
        if (animation < 1) {
          animation = 11;
        }
        lastButton2Time = currentTime;
      }
      display.showNumberDec(animation, false, 2, 2);
      display.setSegments(a, 1, 0);
    }
    if (subMode == 2) {
      if (digitalRead(button1) && (currentTime - lastButton1Time >= brightnessDelay)) {
        if (animationBrightness < 100) {
          animationBrightness++;
        }
        lastButton1Time = currentTime;
      }
      if (digitalRead(button2) && (currentTime - lastButton2Time >= brightnessDelay)) {
        if (animationBrightness > 1) {
          animationBrightness--;
        }
        lastButton2Time = currentTime;
      }
      display.showNumberDec(animationBrightness, false, 3, 1);
      display.setSegments(b, 1, 0);
    }
    if (subMode == 3) {
      if (digitalRead(button1) && (currentTime - lastButton1Time >= debounceDelay)) {
        if (displayBrightness < 7) {
          displayBrightness++;
        }
        lastButton1Time = currentTime;
      }
      if (digitalRead(button2) && (currentTime - lastButton2Time >= debounceDelay)) {
        if (displayBrightness > 1) {
          displayBrightness--;
        }
        lastButton2Time = currentTime;
      }
      display.showNumberDec(displayBrightness, false, 1, 3);
      display.setSegments(d, 1, 0);
    }
    display.setBrightness(displayBrightness);
    switch (animation) {
      case 1: a1(); break;
      case 2: a2(); break;
      case 3: a3(); break;
      case 4: a4(); break;
      case 5: a5(); break;
      case 6: a6(); break;
      case 7: a7(); break;
      case 8: a8(); break;
      case 9: a9(); break;
      case 10: a10(); break;
      case 11: a11(); break;
    }
  }
  if (mode == 2) {
    currentTime2 = millis();
    currentTime3 = millis();
    if (digitalRead(button7) && (currentTime3 - lastButton7Time >= debounceDelay)) {
      Serial.println(gamePause);
      gamePause = !gamePause;
      lastButton7Time = currentTime3;
    }
    if (digitalRead(button1) && playerLeftPos > 10 && (currentTime2 - lastButton1Time >= debounceDelay)) {
      if (playerLeftPos - 20 != ballPos) {
        playerLeftPos -= 10;
        movePlayerLeft();
      }
      lastButton1Time = currentTime2;
    }
    if (digitalRead(button2) && playerLeftPos < 80 && (currentTime2 - lastButton2Time >= debounceDelay)) {
      if (playerLeftPos + 20 != ballPos) {
        playerLeftPos += 10;
        movePlayerLeft();
      }
      lastButton2Time = currentTime2;
    }
    if (digitalRead(button5) && playerRightPos > 19 && (currentTime2 - lastButton5Time >= debounceDelay)) {
      if (playerRightPos - 20 != ballPos) {
        playerRightPos -= 10;
        movePlayerRight();
      }
      lastButton5Time = currentTime2;
    }
    if (digitalRead(button6) && playerRightPos < 89 && (currentTime2 - lastButton6Time >= debounceDelay)) {
      if (playerRightPos + 20 != ballPos) {
        playerRightPos += 10;
        movePlayerRight();
      }
      lastButton6Time = currentTime2;
    }
    display.showNumberDecEx(scorePlayerLeft, 0b01000000, true, 2, 0);
    display.showNumberDec(scorePlayerRight, true, 2, 2);
    if (gamePause == false) {
      currentTime2 = millis();
      if (currentTime2 - previousMillisForInterval >= 3000 && interval > 150) {
        interval -= 10;
        previousMillisForInterval = currentTime2;
      }
      if (ballOnLEDTop(ballPos)) {
        if (currentTime2 - previousMillis >= interval) {
          directionBall = random(5, 12);
          moveBall();
          previousMillis = currentTime2;
        }
      } else if (ballOnLEDBottom(ballPos)) {
        if (currentTime2 - previousMillis >= interval) {
          int temp[] = { 1, 2, 3, 13, 14, 15, 16 };
          directionBall = temp[random(7)];
          moveBall();
          previousMillis = currentTime2;
        }
      } else if (ballOnDeflectionLEDLeft(ballPos)) {
        if (currentTime2 - previousMillis >= interval) {
          directionBall = random(1, 8);
          moveBall();
          previousMillis = currentTime2;
        }
      } else if (ballOnDeflectionLEDRight(ballPos)) {
        if (currentTime2 - previousMillis >= interval) {
          directionBall = random(9, 16);
          moveBall();
          previousMillis = currentTime2;
        }
      } else if (ballOnScoringLEDLeft(ballPos)) {
        led[8].setRGB(255, 255, 255);
        led[98].setRGB(255, 255, 255);
        FastLED.show();
        if (currentTime2 - previousMillis >= 700) {
          scorePlayerRight++;
          prepareGameField();
          led[8].setRGB(0, 0, 0);
          led[98].setRGB(0, 0, 0);
          FastLED.show();
          previousMillis = currentTime2;
        }
      } else if (ballOnScoringLEDRight(ballPos)) {
        led[1].setRGB(255, 255, 255);
        led[91].setRGB(255, 255, 255);
        FastLED.show();
        if (currentTime2 - previousMillis >= 700) {
          scorePlayerLeft++;
          prepareGameField();
          led[1].setRGB(0, 0, 0);
          led[91].setRGB(0, 0, 0);
          FastLED.show();
          previousMillis = currentTime2;
        }
      } else {
        currentTime4 = millis();
        Serial.println("works");
        if (currentTime4 - previousMillis >= interval) {
          moveBall();
          previousMillis = currentTime4;
        }
      }
    }
  }
}



void a1() {
  unsigned long currentTimeAnimation = millis();
  if (currentTimeAnimation - lastTimeAnimation >= animationDelay) {
    for (int i = 0; i < NUM_LEDS; i++) {
      led[i].setRGB(random(0, 256),random(0, 256),random(0, 256));
    }
    FastLED.setBrightness(animationBrightness);
    FastLED.show();
    lastTimeAnimation = currentTimeAnimation;
  }
}

